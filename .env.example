# =============================================================================
# Bot de notícias de mercado -> Telegram
# Copie este arquivo para .env e preencha os dois primeiros campos.
# =============================================================================

# Token gerado pelo @BotFather (formato: 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Destino das mensagens:
#   - canal público:     @meu_canal
#   - canal/grupo privado: id numérico (use: python bot.py --chats)
#   - conversa privada:  id numérico (use: python bot.py --chats)
TELEGRAM_CHAT_ID=

# Opcional: id do tópico dentro de um grupo com tópicos (tópicos/foruns).
# Deixe vazio para enviar na conversa principal do grupo.
# Descubra com: python bot.py --chats (ou o id do tópico mostrado no Telegram)
TELEGRAM_THREAD_ID=

# -----------------------------------------------------------------------------
# Fontes (separe por vírgula):
#   - fj                  : Financial Juice (RSS público)
#   - fxstreet            : FXStreet (RSS notícias)
#   - investing           : Investing.com Forex (EN)
#   - investing_stocks    : Investing.com Ações (EN)
#   - investing_br        : Investing.com Brasil Economia (PT-BR)
#   - investing_br_forex  : Investing.com Brasil Câmbio (PT-BR)
#   - investing_br_stocks : Investing.com Brasil Ações (PT-BR)
#   - yahoo               : Yahoo Finance Mercados (Índices/Ouro/Petróleo/Dólar)
#   - reuters             : Reuters (via Google News, matérias das últimas 24 h)
# -----------------------------------------------------------------------------
SOURCES=fj,fxstreet,investing,investing_stocks

# -----------------------------------------------------------------------------
# Ritmo
# -----------------------------------------------------------------------------
# Intervalo entre ciclos, em segundos. O Financial Juice limita requisições;
# se aparecer HTTP 429 com frequência, aumente para 180 ou 300.
POLL_SECONDS=120

# Pausa entre mensagens enviadas (evita o limite do Telegram).
SEND_DELAY_SECONDS=3.0

# Até quantos itens enviar individualmente; acima disso vira um resumo (digest).
SINGLE_MAX=4

# Limites de segurança por ciclo.
MAX_ITEMS_PER_CYCLE=40
MAX_MESSAGES_PER_CYCLE=12

# Tempo máximo de espera ao buscar cada RSS, em segundos.
FETCH_TIMEOUT=30

# -----------------------------------------------------------------------------
# Primeira execução
# -----------------------------------------------------------------------------
# Na primeira execução o bot marca o feed atual como "já visto" e não envia nada,
# para não inundar o canal com notícias antigas. Defina true para enviar as
# últimas BACKLOG_LIMIT notícias logo na primeira execução.
SEND_BACKLOG=false
BACKLOG_LIMIT=5

# -----------------------------------------------------------------------------
# Conteúdo
# -----------------------------------------------------------------------------
# Inclui o resumo da notícia quando o RSS fornece (o FXStreet fornece).
INCLUDE_SUMMARY=true

# Filtros opcionais (vale para TODAS as fontes; as fontes podem sobrescrever):
# Vazio = passa tudo. Separe por vírgula. A comparação ignora maiúsculas/minúsculas
# e acentos, e olha título + resumo.
# Exemplo para tirar ruído: EXCLUDE_KEYWORDS=celebrity,sports,football,ufc
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=

# -----------------------------------------------------------------------------
# Filtro por fonte
# -----------------------------------------------------------------------------
# Financial Juice: o RSS público não traz a categoria da notícia, então o bot
# filtra por palavras-chave. Deixe vazio para usar o padrão (Forex, Índices e Macro).
# Deixe "FJ_CATEGORIES=all" para receber tudo (inclusive cripto, commodities,
# ações individuais etc.).
FJ_CATEGORIES=forex,index,macro
# Sobrescreve o filtro padrão do FJ (usado só se você preencher):
FJ_INCLUDE_KEYWORDS=
FJ_EXCLUDE_KEYWORDS=

# FXStreet: importance = only notícias importantes (padrão)
#   important = breaking + termos macro/mercado (Fed, CPI, payrolls, guerras...)
#   breaking  = apenas títulos que começam com Breaking/Update/Live
#   all       = tudo que sai em /news/
FXSTREET_IMPORTANCE=important
# Sobrescreve a lista de termos "importantes" (usado só se você preencher):
FXSTREET_INCLUDE_KEYWORDS=
FXSTREET_EXCLUDE_KEYWORDS=

# Filtro da Reuters (via Google News):
#   important = apenas macro/mercado (Fed, inflação, dólar, petróleo, bolsas...)
#   all       = tudo que a Reuters publica (inclui esporte e política)
REUTERS_IMPORTANCE=important
REUTERS_INCLUDE_KEYWORDS=
REUTERS_EXCLUDE_KEYWORDS=

# Converte o link do Google News no link real da Reuters (melhora o preview).
RESOLVE_LINKS=true
RESOLVE_LINKS_MAX_PER_CYCLE=10

# -----------------------------------------------------------------------------
# Briefing do calendário econômico (Forex Factory)
# -----------------------------------------------------------------------------
# Envia toda manhã, uma vez por dia, os eventos importantes do dia.
CALENDAR_ENABLED=true
# Hora do envio, no formato HH:MM (fuso definido em TIMEZONE).
CALENDAR_AT=07:00
# Quais impactos considerar: high, medium, low, none (aceita alto/médio/baixo).
CALENDAR_IMPACTS=High
# Filtra por país. Vazio = todos. Use os códigos do Forex Factory:
# US, EZ, UK, JP, AU, CA, CH, CN, DE, FR, IT, NZ, EU...
CALENDAR_COUNTRIES=
# Provedor do calendário: forexfactory (padrão via .ics) ou tradingview (JSON público)
CALENDAR_SOURCE=forexfactory

# Fuso usado nos horários das mensagens:
#   local              = fuso do computador (padrão)
#   UTC
#   UTC-3              = offset fixo
#   America/Sao_Paulo  = nome IANA (precisa de tzdata no Windows; há fallback)
TIMEZONE=local

# Notificações: true envia sem som/vibração.
DISABLE_NOTIFICATION=false

# true desativa o preview de links no Telegram.
DISABLE_PREVIEW=true

# Quando DISABLE_PREVIEW=false:
#   PREVIEW_LARGE  = true usa imagem grande no card do link
#   PREVIEW_DIGEST = true mostra preview também nos resumos (digest)
PREVIEW_LARGE=true
PREVIEW_DIGEST=false

# Tradução das manchetes para português (usa Google Translate público + cache).
TRANSLATE_ENABLED=false
TRANSLATE_TARGET=pt-BR
TRANSLATE_MAX_PER_CYCLE=20

# -----------------------------------------------------------------------------
# Arquivos e avançado
# -----------------------------------------------------------------------------
STATE_FILE=state.json
LOG_FILE=bot.log
# USER_AGENT=Mozilla/5.0 ... MarketNewsBot/1.0
